<div class="container mx-auto px-4 py-8 max-w-2xl">
  <div class="mb-6">
    <%= link_to "← Back to Video", video_path(@video), class: "text-blue-400 hover:text-blue-300" %>
  </div>

  <h1 class="text-3xl font-bold mb-8">Edit Video</h1>

  <%= form_with(model: @video, local: true, html: { multipart: true, class: "space-y-6" }) do |f| %>
    <!-- Error Messages -->
    <% if @video.errors.any? %>
      <div class="bg-red-900/50 border border-red-600 rounded-lg p-4">
        <h3 class="font-bold text-red-400 mb-2">
          <%= pluralize(@video.errors.count, "error") %> prevented this video from being saved:
        </h3>
        <ul class="list-disc list-inside text-red-300">
          <% @video.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Current Status -->
    <div class="bg-gray-800 rounded-lg p-6">
      <h2 class="text-xl font-bold mb-4">Current Status</h2>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-gray-400 text-sm">Upload Status</p>
          <p class="font-bold text-lg capitalize <%= status_color_class(@video.status) %>">
            <%= @video.status %>
          </p>
        </div>
        <% if @video.youtube_video_id %>
          <a href="<%= @video.video_url %>" target="_blank" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">
            View on YouTube
          </a>
        <% end %>
      </div>
    </div>

    <!-- YouTube Account -->
    <div class="bg-gray-800 rounded-lg p-6">
      <h2 class="text-xl font-bold mb-4">YouTube Account</h2>

      <% if @youtube_accounts.any? %>
        <%= f.collection_select :youtube_account_id, @youtube_accounts, :id, :channel_title,
          {},
          { class: "w-full bg-gray-700 border border-gray-600 rounded px-4 py-2 focus:outline-none focus:border-blue-500" }
        %>
        <% if @video.youtube_video_id %>
          <p class="text-yellow-400 text-sm mt-2">
            ⚠️ Changing the YouTube account won't affect the already uploaded video
          </p>
        <% end %>
      <% else %>
        <div class="bg-yellow-900/30 border border-yellow-600 rounded p-4">
          <p class="text-yellow-400 mb-3">You need to connect a YouTube account first.</p>
          <%= link_to "Connect YouTube", integrations_youtube_connect_path, class: "inline-block bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
        </div>
      <% end %>
    </div>

    <!-- Replace Video File (if not uploaded yet) -->
    <% unless @video.uploaded? || @video.processing? %>
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-xl font-bold mb-4">Video File</h2>

        <% if @video.file.attached? %>
          <div class="bg-gray-700 rounded p-4 mb-4">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-semibold"><%= @video.file.blob.filename %></p>
                <p class="text-gray-400 text-sm"><%= number_to_human_size(@video.file.blob.byte_size) %></p>
              </div>
              <span class="text-green-400">✓ Uploaded</span>
            </div>
          </div>
        <% end %>

        <div class="border-2 border-dashed border-gray-600 rounded-lg p-8 text-center hover:border-blue-500 transition-colors">
          <%= f.file_field :file,
            accept: "video/mp4,video/quicktime,video/x-msvideo,video/x-ms-wmv",
            class: "hidden",
            id: "video_file_input",
            onchange: "updateFileName(this)"
          %>
          <label for="video_file_input" class="cursor-pointer">
            <svg class="w-16 h-16 mx-auto text-gray-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
            </svg>
            <p class="text-lg font-semibold mb-2">
              <%= @video.file.attached? ? "Replace video file" : "Upload video file" %>
            </p>
            <p class="text-gray-400 text-sm">MP4, MOV, AVI, or WMV (max 2GB)</p>
            <p class="text-gray-500 text-xs mt-2" id="file_name"></p>
          </label>
        </div>
      </div>
    <% end %>

    <!-- Video Details -->
    <div class="bg-gray-800 rounded-lg p-6 space-y-4">
      <h2 class="text-xl font-bold mb-4">Video Details</h2>

      <!-- Title -->
      <div>
        <%= f.label :title, class: "block text-sm font-medium mb-2" %>
        <%= f.text_field :title,
          placeholder: "Enter video title",
          class: "w-full bg-gray-700 border border-gray-600 rounded px-4 py-2 focus:outline-none focus:border-blue-500",
          maxlength: 100
        %>
        <p class="text-gray-400 text-xs mt-1">Maximum 100 characters</p>
      </div>

      <!-- Description -->
      <div>
        <%= f.label :description, class: "block text-sm font-medium mb-2" %>
        <%= f.text_area :description,
          placeholder: "Enter video description",
          rows: 6,
          class: "w-full bg-gray-700 border border-gray-600 rounded px-4 py-2 focus:outline-none focus:border-blue-500",
          maxlength: 5000
        %>
        <p class="text-gray-400 text-xs mt-1">Maximum 5000 characters</p>
      </div>

      <!-- Privacy Status -->
      <div>
        <%= f.label :privacy_status, "Privacy", class: "block text-sm font-medium mb-2" %>
        <%= f.select :privacy_status,
          [
            ['Public - Anyone can find and watch', 'public'],
            ['Unlisted - Only people with the link can watch', 'unlisted'],
            ['Private - Only you can watch', 'private']
          ],
          {},
          { class: "w-full bg-gray-700 border border-gray-600 rounded px-4 py-2 focus:outline-none focus:border-blue-500" }
        %>
        <% if @video.youtube_video_id %>
          <p class="text-yellow-400 text-sm mt-2">
            ⚠️ You'll need to update privacy on YouTube manually
          </p>
        <% end %>
      </div>

      <!-- Category -->
      <div>
        <%= f.label :category_id, "Category", class: "block text-sm font-medium mb-2" %>
        <%= f.select :category_id,
          [
            ['Gaming', '20'],
            ['Entertainment', '24'],
            ['Music', '10'],
            ['Sports', '17'],
            ['Education', '27'],
            ['Science & Technology', '28'],
            ['People & Blogs', '22']
          ],
          {},
          { class: "w-full bg-gray-700 border border-gray-600 rounded px-4 py-2 focus:outline-none focus:border-blue-500" }
        %>
      </div>

      <!-- Tags -->
      <div>
        <%= f.label :tags, "Tags (comma-separated)", class: "block text-sm font-medium mb-2" %>
        <%= f.text_field :tags,
          value: @video.tags&.join(', '),
          placeholder: "gaming, highlights, stream",
          class: "w-full bg-gray-700 border border-gray-600 rounded px-4 py-2 focus:outline-none focus:border-blue-500"
        %>
        <p class="text-gray-400 text-xs mt-1">Separate tags with commas</p>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex gap-4">
      <%= f.submit "Update Video", class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded cursor-pointer" %>
      <%= link_to "Cancel", video_path(@video), class: "flex-1 text-center bg-gray-700 hover:bg-gray-600 text-white font-bold py-3 px-6 rounded" %>
    </div>
  <% end %>
</div>

<script>
function updateFileName(input) {
  const fileName = input.files[0]?.name;
  const fileSize = input.files[0]?.size;
  const fileNameEl = document.getElementById('file_name');

  if (fileName) {
    const sizeMB = (fileSize / (1024 * 1024)).toFixed(2);
    fileNameEl.textContent = `${fileName} (${sizeMB} MB)`;
  } else {
    fileNameEl.textContent = '';
  }
}
</script>
