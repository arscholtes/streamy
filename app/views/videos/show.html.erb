<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="mb-6">
    <%= link_to "← Back to Videos", videos_path, class: "text-blue-400 hover:text-blue-300" %>
  </div>

  <!-- Video Title and Actions -->
  <div class="flex justify-between items-start mb-6">
    <div>
      <h1 class="text-3xl font-bold mb-2"><%= @video.title %></h1>
      <div class="flex items-center gap-4 text-gray-400 text-sm">
        <span><%= time_ago_in_words(@video.created_at) %> ago</span>
        <% if @video.view_count && @video.view_count > 0 %>
          <span><%= number_with_delimiter(@video.view_count) %> views</span>
        <% end %>
      </div>
    </div>

    <div class="flex gap-2">
      <%= link_to "Edit", edit_video_path(@video), class: "bg-gray-700 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded" %>
      <%= button_to "Delete", video_path(@video), method: :delete, data: { confirm: "Are you sure you want to delete this video?" }, class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <!-- Status Banner -->
  <div class="mb-6">
    <% case @video.status %>
    <% when 'pending' %>
      <div class="bg-yellow-900/30 border border-yellow-600 rounded-lg p-4">
        <div class="flex items-center">
          <svg class="w-6 h-6 text-yellow-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div class="flex-1">
            <h3 class="font-bold text-yellow-400">Ready to Upload</h3>
            <p class="text-yellow-300 text-sm">Video is ready to be uploaded to YouTube</p>
          </div>
          <% if @video.file.attached? && @video.youtube_account %>
            <%= button_to "Upload to YouTube", upload_to_youtube_video_path(@video), class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
          <% end %>
        </div>
      </div>

    <% when 'processing' %>
      <div class="bg-blue-900/30 border border-blue-600 rounded-lg p-4">
        <div class="flex items-center">
          <svg class="w-6 h-6 text-blue-400 mr-3 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <div>
            <h3 class="font-bold text-blue-400">Uploading to YouTube</h3>
            <p class="text-blue-300 text-sm">Your video is being uploaded. This may take several minutes...</p>
          </div>
        </div>
      </div>

    <% when 'uploaded' %>
      <div class="bg-green-900/30 border border-green-600 rounded-lg p-4">
        <div class="flex items-center">
          <svg class="w-6 h-6 text-green-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div class="flex-1">
            <h3 class="font-bold text-green-400">Upload Complete!</h3>
            <p class="text-green-300 text-sm">Video successfully uploaded to YouTube</p>
          </div>
          <% if @video.video_url %>
            <a href="<%= @video.video_url %>" target="_blank" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">
              View on YouTube
            </a>
          <% end %>
        </div>
      </div>

    <% when 'failed' %>
      <div class="bg-red-900/30 border border-red-600 rounded-lg p-4">
        <div class="flex items-center">
          <svg class="w-6 h-6 text-red-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div class="flex-1">
            <h3 class="font-bold text-red-400">Upload Failed</h3>
            <% if @video.error_message.present? %>
              <p class="text-red-300 text-sm"><%= @video.error_message %></p>
            <% end %>
          </div>
          <% if @video.file.attached? && @video.youtube_account %>
            <%= button_to "Retry Upload", upload_to_youtube_video_path(@video), class: "bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Video Preview / Thumbnail -->
  <div class="bg-gray-800 rounded-lg overflow-hidden mb-6">
    <div class="relative pb-56 bg-gray-900">
      <% if @video.youtube_video_id.present? %>
        <!-- Embedded YouTube Player -->
        <iframe
          class="absolute inset-0 w-full h-full"
          src="https://www.youtube.com/embed/<%= @video.youtube_video_id %>"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
      <% elsif @video.thumbnail_url.present? %>
        <%= image_tag @video.thumbnail_url, class: "absolute inset-0 w-full h-full object-cover" %>
      <% elsif @video.file.attached? %>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="text-center">
            <svg class="w-24 h-24 mx-auto text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <p class="text-gray-400">Video file uploaded</p>
            <p class="text-gray-500 text-sm mt-2">
              <% if @video.file.blob.byte_size %>
                <%= number_to_human_size(@video.file.blob.byte_size) %>
              <% end %>
            </p>
          </div>
        </div>
      <% else %>
        <div class="absolute inset-0 flex items-center justify-center">
          <p class="text-gray-500">No video file uploaded yet</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Video Details -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Main Details -->
    <div class="md:col-span-2 space-y-6">
      <!-- Description -->
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-xl font-bold mb-3">Description</h2>
        <% if @video.description.present? %>
          <p class="text-gray-300 whitespace-pre-wrap"><%= @video.description %></p>
        <% else %>
          <p class="text-gray-500 italic">No description provided</p>
        <% end %>
      </div>

      <!-- Tags -->
      <% if @video.tags.present? && @video.tags.any? %>
        <div class="bg-gray-800 rounded-lg p-6">
          <h2 class="text-xl font-bold mb-3">Tags</h2>
          <div class="flex flex-wrap gap-2">
            <% @video.tags.each do |tag| %>
              <span class="bg-gray-700 px-3 py-1 rounded-full text-sm"><%= tag %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar Info -->
    <div class="space-y-6">
      <!-- YouTube Info -->
      <% if @video.youtube_account %>
        <div class="bg-gray-800 rounded-lg p-6">
          <h3 class="font-bold mb-3">YouTube Channel</h3>
          <div class="flex items-center">
            <% if @video.youtube_account.thumbnail_url %>
              <%= image_tag @video.youtube_account.thumbnail_url, class: "w-10 h-10 rounded-full mr-3" %>
            <% end %>
            <div>
              <p class="font-semibold"><%= @video.youtube_account.channel_title %></p>
              <% if @video.youtube_account.subscriber_count %>
                <p class="text-gray-400 text-sm"><%= number_to_human(@video.youtube_account.subscriber_count) %> subscribers</p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Video Info -->
      <div class="bg-gray-800 rounded-lg p-6">
        <h3 class="font-bold mb-3">Video Details</h3>
        <dl class="space-y-2 text-sm">
          <div>
            <dt class="text-gray-400">Status</dt>
            <dd class="font-semibold capitalize"><%= @video.status %></dd>
          </div>

          <div>
            <dt class="text-gray-400">Privacy</dt>
            <dd class="font-semibold capitalize"><%= @video.privacy_status %></dd>
          </div>

          <div>
            <dt class="text-gray-400">Category</dt>
            <dd class="font-semibold"><%= video_category_name(@video.category_id) %></dd>
          </div>

          <% if @video.duration_seconds %>
            <div>
              <dt class="text-gray-400">Duration</dt>
              <dd class="font-semibold"><%= Time.at(@video.duration_seconds).utc.strftime("%H:%M:%S") %></dd>
            </div>
          <% end %>

          <% if @video.youtube_video_id %>
            <div>
              <dt class="text-gray-400">YouTube ID</dt>
              <dd class="font-mono text-xs"><%= @video.youtube_video_id %></dd>
            </div>
          <% end %>

          <div>
            <dt class="text-gray-400">Created</dt>
            <dd><%= @video.created_at.strftime("%b %d, %Y") %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>
