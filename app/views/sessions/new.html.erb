<%# app/views/sessions/new.html.erb %>
<%# This is the login form view %>
<%# Learn more about ERB templates: https://guides.rubyonrails.org/layouts_and_rendering.html %>

<%# Set the page title %>
<%# This will be displayed in the browser tab %>
<% content_for :title, "Login" %>

<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-md-6">
      <%# Card component for styling the login form %>
      <div class="card">
        <div class="card-header text-center">
          <h2>Login to Your Account</h2>
        </div>
        <div class="card-body">
          <%# Display flash messages (errors/success) %>
          <%# flash is a hash containing messages from the controller %>
          <% if flash[:danger] %>
            <%# Bootstrap alert component for error messages %>
            <div class="alert alert-danger" role="alert">
              <%= flash[:danger] %>
            </div>
          <% end %>

          <% if flash[:success] %>
            <%# Bootstrap alert component for success messages %>
            <div class="alert alert-success" role="alert">
              <%= flash[:success] %>
            </div>
          <% end %>

          <%# form_with is a Rails form helper %>
          <%# url: session_path - submits to POST /session %>
          <%# scope: :session - nests params under params[:session] %>
          <%# local: true - disables Turbo/AJAX (submits normally) %>
          <%# Learn more: https://guides.rubyonrails.org/form_helpers.html %>
          <%= form_with url: session_path, scope: :session, local: true do |form| %>

            <%# Username/Email field %>
            <div class="mb-3">
              <%# form.label creates a <label> element %>
              <%= form.label :username, "Username or Email", class: "form-label" %>

              <%# form.text_field creates an <input type="text"> element %>
              <%# class: adds Bootstrap styling %>
              <%# placeholder: shows hint text inside the input %>
              <%# required: makes the field required (HTML5 validation) %>
              <%= form.text_field :username,
                class: "form-control",
                placeholder: "Enter your username or email",
                required: true,
                autocomplete: "username" %>
            </div>

            <%# Password field %>
            <div class="mb-3">
              <%= form.label :password, "Password", class: "form-label" %>

              <%# form.password_field creates an <input type="password"> element %>
              <%# This hides the password as the user types %>
              <%= form.password_field :password,
                class: "form-control",
                placeholder: "Enter your password",
                required: true,
                autocomplete: "current-password" %>
            </div>

            <%# Submit button %>
            <div class="d-grid">
              <%# form.submit creates a submit button %>
              <%# "Log In" is the button text %>
              <%= form.submit "Log In", class: "btn btn-primary btn-block" %>
            </div>
          <% end %>

          <%# Link to signup page %>
          <div class="mt-3 text-center">
            <p>
              Don't have an account?
              <%# link_to creates a hyperlink %>
              <%# signup_path is the route helper for /signup %>
              <%= link_to "Sign up here", signup_path %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
