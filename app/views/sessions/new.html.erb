<%# app/views/sessions/new.html.erb %>
<%# This is the login form view %>
<%# Learn more about ERB templates: https://guides.rubyonrails.org/layouts_and_rendering.html %>

<%# Set the page title %>
<%# This will be displayed in the browser tab %>
<% content_for :title, "Login" %>

<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5 fade-in">
      <%# Glass card for the login form %>
      <div class="glass-card" style="box-shadow: var(--glow-purple);">
        <div class="text-center mb-4">
          <h2 class="gradient-text"><i class="bi bi-box-arrow-in-right"></i> Login to Your Account</h2>
          <p style="color: var(--text-muted); margin-top: 0.5rem;">Welcome back to StreamHub</p>
        </div>

        <%# form_with is a Rails form helper %>
        <%# url: session_path - submits to POST /session %>
        <%# scope: :session - nests params under params[:session] %>
        <%# local: true - disables Turbo/AJAX (submits normally) %>
        <%= form_with url: session_path, scope: :session, local: true do |form| %>

          <%# Username/Email field %>
          <div class="mb-4">
            <%= form.label :username, "Username or Email", class: "form-label", style: "color: var(--text-secondary);" %>
            <%= form.text_field :username,
              class: "form-control-dark",
              placeholder: "Enter your username or email",
              required: true,
              autocomplete: "username" %>
          </div>

          <%# Password field %>
          <div class="mb-4">
            <%= form.label :password, "Password", class: "form-label", style: "color: var(--text-secondary);" %>
            <%= form.password_field :password,
              class: "form-control-dark",
              placeholder: "Enter your password",
              required: true,
              autocomplete: "current-password" %>
          </div>

          <%# Submit button %>
          <div class="d-grid mb-4">
            <%= form.submit "Log In", class: "btn-gradient-primary" %>
          </div>
        <% end %>

        <%# Link to signup page %>
        <div class="text-center">
          <p style="color: var(--text-muted);">
            Don't have an account?
            <%= link_to "Sign up here", signup_path, class: "gradient-text", style: "text-decoration: none; font-weight: 600;" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
