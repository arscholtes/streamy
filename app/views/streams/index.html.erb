<%# app/views/streams/index.html.erb %>
<%# Stream Discovery & Browse Page %>

<% content_for :title, "Browse Streams" %>

<%# Hero Header with Stats %>
<div style="background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%); padding: 3rem 0; margin-bottom: 2rem; position: relative; overflow: hidden;">
  <div style="position: absolute; top: -50%; right: -10%; width: 600px; height: 600px; background: radial-gradient(circle, rgba(239, 68, 68, 0.15), transparent); border-radius: 50%; filter: blur(100px);"></div>
  <div style="position: absolute; bottom: -50%; left: -10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(139, 92, 246, 0.15), transparent); border-radius: 50%; filter: blur(100px);"></div>

  <div class="container">
    <div class="row align-items-center fade-in">
      <div class="col-lg-6">
        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; margin-bottom: 1rem; line-height: 1.1;">
          Discover<br><span class="gradient-text">Live Streams</span>
        </h1>
        <p style="font-size: 1.25rem; color: var(--text-muted); margin-bottom: 0;">
          Watch amazing content from talented streamers around the world
        </p>
      </div>
      <div class="col-lg-6">
        <div class="row g-3">
          <div class="col-6">
            <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--radius-lg); padding: 1.5rem; text-align: center;">
              <div style="font-size: 3rem; font-weight: 800; margin-bottom: 0.5rem;" class="gradient-text">
                <%= @total_live %>
              </div>
              <div style="color: var(--text-muted); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px;">
                <i class="bi bi-broadcast"></i> Live Now
              </div>
            </div>
          </div>
          <div class="col-6">
            <div style="background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: var(--radius-lg); padding: 1.5rem; text-align: center;">
              <div style="font-size: 3rem; font-weight: 800; margin-bottom: 0.5rem;" class="gradient-text">
                <%= @total_streams %>
              </div>
              <div style="color: var(--text-muted); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.5px;">
                <i class="bi bi-camera-video"></i> Total Channels
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container fade-in-delay-1">
  <%# Search & Filters %>
  <div class="glass-card mb-4">
    <div class="row g-3 align-items-end">
      <%# Search Bar %>
      <div class="col-lg-5">
        <%= form_with url: streams_path, method: :get, local: true do |f| %>
          <label style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.5rem; display: block; font-size: 0.875rem;">
            <i class="bi bi-search"></i> Search Streams
          </label>
          <div class="input-group">
            <%= f.text_field :search,
              value: params[:search],
              placeholder: "Search by title or streamer...",
              class: "form-control-dark",
              style: "border-top-right-radius: 0; border-bottom-right-radius: 0;" %>
            <button type="submit" class="btn-gradient-primary" style="border-top-left-radius: 0; border-bottom-left-radius: 0; padding: 0 2rem;">
              <i class="bi bi-search"></i>
            </button>
          </div>
        <% end %>
      </div>

      <%# Filter Buttons %>
      <div class="col-lg-4">
        <label style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.5rem; display: block; font-size: 0.875rem;">
          <i class="bi bi-funnel"></i> Filter
        </label>
        <div style="display: flex; gap: 0.5rem;">
          <%= link_to streams_path(filter: 'live', search: params[:search]),
            class: "btn-#{params[:filter] != 'all' ? 'gradient-primary' : 'outline-gradient'}",
            style: "flex: 1; text-align: center; padding: 0.75rem;" do %>
            <i class="bi bi-circle-fill" style="font-size: 0.5rem; color: var(--accent-red);"></i> Live Only
          <% end %>
          <%= link_to streams_path(filter: 'all', search: params[:search]),
            class: "btn-#{params[:filter] == 'all' ? 'gradient-primary' : 'outline-gradient'}",
            style: "flex: 1; text-align: center; padding: 0.75rem;" do %>
            <i class="bi bi-list"></i> All Streams
          <% end %>
        </div>
      </div>

      <%# Sort Dropdown %>
      <div class="col-lg-3">
        <label style="color: var(--text-secondary); font-weight: 600; margin-bottom: 0.5rem; display: block; font-size: 0.875rem;">
          <i class="bi bi-sort-down"></i> Sort By
        </label>
        <%= form_with url: streams_path, method: :get, local: true do |f| %>
          <%= f.hidden_field :filter, value: params[:filter] %>
          <%= f.hidden_field :search, value: params[:search] %>
          <%= f.select :sort,
            [['Most Recent', 'recent'], ['Most Popular', 'popular']],
            { selected: params[:sort] || 'recent' },
            {
              class: 'form-control-dark',
              onchange: 'this.form.submit()',
              style: 'cursor: pointer;'
            } %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Streams Grid %>
  <% if @streams.any? %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
      <% @streams.each do |stream| %>
        <%= link_to stream_path(stream), style: "text-decoration: none; color: inherit;" do %>
          <div class="glass-card feature-card" style="padding: 0; overflow: hidden; transition: all var(--transition-base);">
            <%# Thumbnail %>
            <div style="position: relative; aspect-ratio: 16/9; overflow: hidden; background: linear-gradient(135deg, var(--bg-secondary), var(--bg-tertiary));">
              <img src="<%= stream.thumbnail_url %>"
                   alt="<%= stream.title %>"
                   style="width: 100%; height: 100%; object-fit: cover;">

              <%# Live Badge %>
              <% if stream.live? %>
                <div style="position: absolute; top: 0.75rem; left: 0.75rem;">
                  <span class="badge-live" style="font-size: 0.75rem; padding: 0.375rem 0.75rem;">
                    <i class="bi bi-broadcast"></i> LIVE
                  </span>
                </div>
                <%# Viewer Count %>
                <div style="position: absolute; bottom: 0.75rem; right: 0.75rem;">
                  <span style="background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(10px); border-radius: var(--radius-md); padding: 0.375rem 0.75rem; font-size: 0.75rem; font-weight: 600; color: white;">
                    <i class="bi bi-eye-fill"></i> <%= stream.viewer_count %>
                  </span>
                </div>
              <% else %>
                <div style="position: absolute; top: 0.75rem; left: 0.75rem;">
                  <span class="badge-offline" style="font-size: 0.75rem; padding: 0.375rem 0.75rem;">
                    <i class="bi bi-circle"></i> OFFLINE
                  </span>
                </div>
              <% end %>
            </div>

            <%# Stream Info %>
            <div style="padding: 1.25rem;">
              <%# Streamer Avatar & Name %>
              <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem;">
                <div style="width: 40px; height: 40px; background: var(--gradient-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.125rem; flex-shrink: 0;">
                  <%= stream.user.username[0].upcase %>
                </div>
                <div style="min-width: 0; flex: 1;">
                  <div style="font-weight: 600; color: var(--text-primary); font-size: 0.875rem; margin-bottom: 0.125rem;">
                    <%= stream.user.username %>
                  </div>
                  <div style="font-size: 0.75rem; color: var(--text-muted);">
                    <%= time_ago_in_words(stream.updated_at) %> ago
                  </div>
                </div>
              </div>

              <%# Stream Title %>
              <h5 style="font-size: 1rem; font-weight: 700; margin-bottom: 0; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                <%= stream.title %>
              </h5>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Pagination %>
    <% if @streams.respond_to?(:total_pages) && @streams.total_pages > 1 %>
      <div style="display: flex; justify-content: center; margin-top: 3rem;">
        <div style="background: rgba(26, 31, 58, 0.6); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-lg); padding: 0.5rem; display: flex; gap: 0.5rem;">
          <%= paginate @streams, theme: 'streamhub' %>
        </div>
      </div>
    <% end %>

  <% else %>
    <%# Empty State %>
    <div class="glass-card" style="text-align: center; padding: 4rem 2rem;">
      <i class="bi bi-camera-video-off display-1 gradient-text"></i>
      <h3 style="margin-top: 1.5rem; font-size: 1.75rem; font-weight: 700;">
        <span class="gradient-text">No Streams Found</span>
      </h3>
      <p style="color: var(--text-muted); margin: 1rem auto 2rem; max-width: 500px;">
        <% if params[:search].present? %>
          No streams match your search "<strong><%= params[:search] %></strong>". Try different keywords or check back later!
        <% elsif params[:filter] == 'all' %>
          There are no streams available at the moment. Check back soon!
        <% else %>
          There are no live streams right now. Check back soon or explore all streams!
        <% end %>
      </p>
      <% if params[:search].present? || params[:filter] != 'all' %>
        <%= link_to streams_path, class: "btn-gradient-primary" do %>
          <i class="bi bi-arrow-left"></i> View All Streams
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<style>
/* Stream card hover effects */
.feature-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--glow-purple-intense);
}

.feature-card img {
  transition: transform var(--transition-slow);
}

.feature-card:hover img {
  transform: scale(1.05);
}
</style>
