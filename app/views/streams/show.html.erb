<%# app/views/streams/show.html.erb %>
<%# Individual Stream Viewer Page %>

<% content_for :title, "#{@stream.title} - #{@stream.user.username}" %>

<div class="container-fluid" style="max-width: 2000px; padding: 0;">
  <div class="row g-0">
    <%# Main Content - Video Player & Info %>
    <div class="col-xl-9 col-lg-8" style="background: var(--bg-primary);">
      <%# Video Player %>
      <div style="position: relative; aspect-ratio: 16/9; background: #000;">
        <% if @stream.live? %>
          <%# Live Stream Player %>
          <video id="streamPlayer"
                 controls
                 autoplay
                 muted
                 style="width: 100%; height: 100%; background: #000;">
            <source src="<%= @stream.playback_url %>" type="application/x-mpegURL">
            Your browser does not support the video tag.
          </video>

          <%# Live Overlay Badge %>
          <div style="position: absolute; top: 1.5rem; left: 1.5rem; z-index: 10;">
            <div class="badge-live" style="font-size: 1rem; padding: 0.75rem 1.5rem; animation: pulse-glow 2s infinite;">
              <i class="bi bi-broadcast"></i> LIVE
            </div>
          </div>

          <%# Viewer Count %>
          <div style="position: absolute; top: 1.5rem; right: 1.5rem; z-index: 10;">
            <div style="background: rgba(0, 0, 0, 0.8); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-md); padding: 0.75rem 1.25rem; font-weight: 600;">
              <i class="bi bi-eye-fill" style="color: var(--accent-red);"></i>
              <span style="color: white; margin-left: 0.5rem;"><%= @stream.viewer_count %> viewers</span>
            </div>
          </div>
        <% else %>
          <%# Offline State %>
          <div style="display: flex; align-items: center; justify-content: center; height: 100%; background: linear-gradient(135deg, var(--bg-primary), var(--bg-secondary));">
            <div style="text-align: center;">
              <i class="bi bi-camera-video-off display-1 gradient-text"></i>
              <h3 style="margin-top: 1.5rem; font-size: 2rem; font-weight: 700;">
                <span class="gradient-text">Stream Offline</span>
              </h3>
              <p style="color: var(--text-muted); margin-top: 1rem;">
                <strong><%= @stream.user.username %></strong> is not currently streaming
              </p>
              <p style="color: var(--text-muted); font-size: 0.875rem;">
                Last streamed <%= time_ago_in_words(@stream.updated_at) %> ago
              </p>
            </div>
          </div>
        <% end %>
      </div>

      <%# Stream Info Section %>
      <div style="padding: 2rem;">
        <%# Streamer Info Bar %>
        <div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 2rem;">
          <%# Streamer Avatar %>
          <%= link_to user_path(@stream.user), style: "text-decoration: none;" do %>
            <div style="width: 60px; height: 60px; background: var(--gradient-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.75rem; flex-shrink: 0; transition: transform var(--transition-base); cursor: pointer;"
                 onmouseover="this.style.transform='scale(1.05)'"
                 onmouseout="this.style.transform='scale(1)'">
              <%= @stream.user.username[0].upcase %>
            </div>
          <% end %>

          <%# Streamer Details %>
          <div style="flex: 1; min-width: 0;">
            <%= link_to user_path(@stream.user), style: "text-decoration: none;" do %>
              <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--text-primary);">
                <%= @stream.user.username %>
              </h3>
            <% end %>
            <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
              <span style="color: var(--text-muted); font-size: 0.875rem;">
                <i class="bi bi-calendar"></i> Streaming since <%= @stream.user.created_at.strftime("%B %Y") %>
              </span>
              <% if @stream.user.subscription_tier != "free" %>
                <span class="badge-pro" style="font-size: 0.75rem; padding: 0.25rem 0.75rem;">PREMIUM</span>
              <% end %>
            </div>
          </div>

          <%# Follow Button %>
          <% if current_user && current_user != @stream.user %>
            <button class="btn-gradient-primary" style="padding: 0.75rem 2rem;">
              <i class="bi bi-heart"></i> Follow
            </button>
          <% elsif current_user == @stream.user %>
            <%= link_to edit_stream_path(@stream), class: "btn-outline-gradient" do %>
              <i class="bi bi-gear"></i> Edit Stream
            <% end %>
          <% end %>
        </div>

        <%# Stream Title & Description %>
        <div class="glass-card" style="margin-bottom: 2rem;">
          <h2 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-primary);">
            <%= @stream.title %>
          </h2>
          <div style="color: var(--text-secondary); line-height: 1.6;">
            <p>Welcome to my stream! Thanks for watching!</p>
          </div>

          <%# Stream Tags/Categories (placeholder) %>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.5rem;">
            <span style="background: rgba(139, 92, 246, 0.15); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: var(--radius-md); padding: 0.5rem 1rem; font-size: 0.875rem; color: var(--text-primary);">
              <i class="bi bi-controller"></i> Gaming
            </span>
            <span style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: var(--radius-md); padding: 0.5rem 1rem; font-size: 0.875rem; color: var(--text-primary);">
              English
            </span>
          </div>
        </div>

        <%# Related/Recommended Streams %>
        <% if @related_streams.any? %>
          <div>
            <h4 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--text-primary);">
              <i class="bi bi-stars gradient-text"></i>
              <span class="gradient-text">Other Live Streams</span>
            </h4>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem;">
              <% @related_streams.each do |related_stream| %>
                <%= link_to stream_path(related_stream), style: "text-decoration: none; color: inherit;" do %>
                  <div class="glass-card feature-card" style="padding: 0; overflow: hidden;">
                    <div style="position: relative; aspect-ratio: 16/9; overflow: hidden; background: linear-gradient(135deg, var(--bg-secondary), var(--bg-tertiary));">
                      <img src="<%= related_stream.thumbnail_url %>"
                           alt="<%= related_stream.title %>"
                           style="width: 100%; height: 100%; object-fit: cover;">
                      <div style="position: absolute; top: 0.5rem; left: 0.5rem;">
                        <span class="badge-live" style="font-size: 0.625rem; padding: 0.25rem 0.5rem;">LIVE</span>
                      </div>
                      <div style="position: absolute; bottom: 0.5rem; right: 0.5rem;">
                        <span style="background: rgba(0, 0, 0, 0.8); border-radius: var(--radius-sm); padding: 0.25rem 0.5rem; font-size: 0.625rem; font-weight: 600; color: white;">
                          <i class="bi bi-eye-fill"></i> <%= related_stream.viewer_count %>
                        </span>
                      </div>
                    </div>
                    <div style="padding: 1rem;">
                      <div style="font-weight: 600; font-size: 0.875rem; margin-bottom: 0.25rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        <%= related_stream.title %>
                      </div>
                      <div style="font-size: 0.75rem; color: var(--text-muted);">
                        <%= related_stream.user.username %>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# Sidebar - Chat %>
    <div class="col-xl-3 col-lg-4" style="background: var(--bg-secondary); border-left: 1px solid rgba(255, 255, 255, 0.1); min-height: 100vh;">
      <div data-controller="chat"
           data-chat-stream-id-value="<%= @stream.id %>"
           style="position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column;">
        <%# Chat Header %>
        <div style="padding: 1.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
          <h5 style="font-weight: 700; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
            <i class="bi bi-chat-dots gradient-text"></i>
            <span class="gradient-text">Stream Chat</span>
          </h5>
        </div>

        <%# Chat Messages %>
        <div id="chatMessages"
             data-chat-target="messages"
             style="flex: 1; overflow-y: auto; padding: 0;">
          <%= turbo_stream_from "stream_#{@stream.id}_chat" %>

          <div id="chat-messages">
            <% if @stream.live? %>
              <% if @chat_messages.any? %>
                <%= render partial: 'chat_messages/message', collection: @chat_messages, as: :message %>
              <% else %>
                <%# No messages yet %>
                <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted); font-size: 0.875rem;">
                  <i class="bi bi-chat-dots display-4 gradient-text"></i>
                  <p style="margin-top: 1rem;">Be the first to send a message!</p>
                </div>
              <% end %>
            <% else %>
              <%# Chat Disabled - Offline %>
              <div style="text-align: center; padding: 3rem 1rem;">
                <i class="bi bi-chat-slash display-4" style="color: var(--text-muted);"></i>
                <p style="color: var(--text-muted); margin-top: 1rem;">
                  Chat is unavailable when the stream is offline
                </p>
              </div>
            <% end %>
          </div>
        </div>

        <%# Chat Input %>
        <% if @stream.live? %>
          <div style="padding: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.1);">
            <% if current_user %>
              <form data-chat-target="form" data-action="submit->chat#submit">
                <div style="display: flex; gap: 0.5rem;">
                  <input type="text"
                         data-chat-target="input"
                         data-action="keydown->chat#handleKeydown"
                         placeholder="Send a message..."
                         class="form-control-dark"
                         style="flex: 1; font-size: 0.875rem;"
                         maxlength="500"
                         required>
                  <button type="submit" class="btn-gradient-primary" style="padding: 0.75rem 1rem;">
                    <i class="bi bi-send"></i>
                  </button>
                </div>
              </form>
              <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem; text-align: center;">
                Press Enter to send • Shift+Enter for new line
              </p>
            <% else %>
              <div style="text-align: center;">
                <%= link_to login_path, class: "btn-gradient-primary", style: "width: 100%;" do %>
                  <i class="bi bi-box-arrow-in-right"></i> Login to Chat
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
/* Custom scrollbar for chat */
#chatMessages::-webkit-scrollbar {
  width: 8px;
}

#chatMessages::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
}

#chatMessages::-webkit-scrollbar-thumb {
  background: rgba(139, 92, 246, 0.5);
  border-radius: 10px;
}

#chatMessages::-webkit-scrollbar-thumb:hover {
  background: rgba(139, 92, 246, 0.7);
}
</style>

<% if @stream.live? %>
  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <script>
    // Initialize HLS.js for live streaming
    document.addEventListener('DOMContentLoaded', function() {
      var video = document.getElementById('streamPlayer');
      var videoSrc = '<%= @stream.playback_url %>';

      if (Hls.isSupported()) {
        var hls = new Hls({
          enableWorker: true,
          lowLatencyMode: true,
        });
        hls.loadSource(videoSrc);
        hls.attachMedia(video);
        hls.on(Hls.Events.MANIFEST_PARSED, function() {
          video.play();
        });
        hls.on(Hls.Events.ERROR, function(event, data) {
          console.log('HLS Error:', data);
        });
      } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        // Safari native HLS support
        video.src = videoSrc;
        video.addEventListener('loadedmetadata', function() {
          video.play();
        });
      }
    });
  </script>
<% end %>
