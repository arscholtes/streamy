<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-8">Donate to <%= @streamer.username %></h1>

  <div class="max-w-2xl mx-auto">
    <div class="bg-white shadow-md rounded-lg p-6">
      <%= form_with url: user_donations_path(@streamer.username), method: :post, class: "space-y-6" do |f| %>
        <!-- Amount Selection -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Select Amount
          </label>
          <div class="grid grid-cols-3 gap-3 mb-4">
            <% @amounts.each do |amount| %>
              <button type="button"
                      onclick="selectAmount(<%= amount %>)"
                      class="amount-btn border-2 border-gray-300 hover:border-blue-500 rounded-lg py-3 px-4 text-center font-semibold transition">
                $<%= '%.2f' % (amount / 100.0) %>
              </button>
            <% end %>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">
              Or enter custom amount
            </label>
            <div class="flex items-center">
              <span class="bg-gray-100 border border-gray-300 rounded-l-lg px-4 py-2">$</span>
              <%= f.number_field :amount_cents,
                  id: 'amount_input',
                  min: 1,
                  step: 0.01,
                  class: "border border-gray-300 rounded-r-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500",
                  placeholder: "0.00",
                  onchange: "updateAmountCents()" %>
            </div>
            <%= f.hidden_field :amount_cents, id: 'amount_cents_hidden' %>
          </div>
        </div>

        <!-- Message -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Message (optional)
          </label>
          <%= f.text_area :message,
              rows: 3,
              class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
              placeholder: "Leave a message for #{@streamer.username}..." %>
        </div>

        <!-- Submit -->
        <div>
          <%= f.submit "Donate Now",
              class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg cursor-pointer transition" %>
        </div>

        <p class="text-xs text-gray-600 text-center">
          Secure payment processing by Stripe. A <%= Payment::DEFAULT_PLATFORM_FEE_PERCENTAGE %>% platform fee applies.
        </p>
      <% end %>
    </div>

    <% if @streamer.stripe_account&.charges_enabled %>
      <div class="mt-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <p class="text-sm text-green-800">
          ✓ <%= @streamer.username %> has donations enabled. Your donation will go directly to them.
        </p>
      </div>
    <% else %>
      <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
        <p class="text-sm text-yellow-800">
          ⚠ <%= @streamer.username %> hasn't set up donations yet. Please check back later.
        </p>
      </div>
    <% end %>
  </div>
</div>

<script>
  function selectAmount(cents) {
    const amountInput = document.getElementById('amount_input');
    const amountCentsHidden = document.getElementById('amount_cents_hidden');

    amountInput.value = (cents / 100).toFixed(2);
    amountCentsHidden.value = cents;

    // Update button styles
    document.querySelectorAll('.amount-btn').forEach(btn => {
      btn.classList.remove('border-blue-500', 'bg-blue-50');
      btn.classList.add('border-gray-300');
    });
    event.target.classList.remove('border-gray-300');
    event.target.classList.add('border-blue-500', 'bg-blue-50');
  }

  function updateAmountCents() {
    const amountInput = document.getElementById('amount_input');
    const amountCentsHidden = document.getElementById('amount_cents_hidden');
    const dollars = parseFloat(amountInput.value) || 0;
    amountCentsHidden.value = Math.round(dollars * 100);

    // Remove preset button selection
    document.querySelectorAll('.amount-btn').forEach(btn => {
      btn.classList.remove('border-blue-500', 'bg-blue-50');
      btn.classList.add('border-gray-300');
    });
  }
</script>
