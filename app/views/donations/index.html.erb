<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-8">Donation History</h1>

  <div class="max-w-6xl mx-auto">
    <!-- Tabs -->
    <div class="mb-6 border-b border-gray-200">
      <nav class="flex space-x-8">
        <button onclick="showTab('sent')"
                id="sent-tab"
                class="tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm">
          Donations Sent
        </button>
        <button onclick="showTab('received')"
                id="received-tab"
                class="tab-btn py-4 px-1 border-b-2 border-transparent font-medium text-sm">
          Donations Received
        </button>
      </nav>
    </div>

    <!-- Sent Donations -->
    <div id="sent-content" class="tab-content">
      <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <% if @sent_donations.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Date
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Recipient
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Amount
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Type
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Status
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @sent_donations.each do |payment| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= payment.created_at.strftime('%b %d, %Y %I:%M %p') %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% if payment.recipient %>
                        <%= link_to payment.recipient.username,
                            user_path(payment.recipient),
                            class: "text-blue-600 hover:text-blue-800" %>
                      <% else %>
                        <span class="text-gray-500">-</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                      $<%= '%.2f' % (payment.amount_cents / 100.0) %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      <%= payment.payment_type.titleize %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full
                        <%= payment.succeeded? ? 'bg-green-100 text-green-800' : payment.failed? ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %>">
                        <%= payment.status.titleize %>
                      </span>
                    </td>
                  </tr>
                  <% if payment.metadata['message'].present? %>
                    <tr class="bg-gray-50">
                      <td colspan="5" class="px-6 py-2 text-sm text-gray-600">
                        <strong>Message:</strong> <%= payment.metadata['message'] %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="p-8 text-center text-gray-600">
            <p>You haven't sent any donations yet.</p>
            <p class="mt-2">
              <%= link_to "Find streamers to support", users_path, class: "text-blue-600 hover:text-blue-800" %>
            </p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Received Donations -->
    <div id="received-content" class="tab-content hidden">
      <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <% if @received_donations.any? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Date
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    From
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Gross Amount
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Platform Fee
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Net Amount
                  </th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Status
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @received_donations.each do |payment| %>
                  <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                      <%= payment.created_at.strftime('%b %d, %Y %I:%M %p') %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <%= link_to payment.user.username,
                          user_path(payment.user),
                          class: "text-blue-600 hover:text-blue-800" %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                      $<%= '%.2f' % (payment.amount_cents / 100.0) %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      $<%= '%.2f' % (payment.platform_fee_cents / 100.0) %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-green-600">
                      $<%= '%.2f' % (payment.recipient_amount_cents / 100.0) %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full
                        <%= payment.succeeded? ? 'bg-green-100 text-green-800' : payment.failed? ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %>">
                        <%= payment.status.titleize %>
                      </span>
                    </td>
                  </tr>
                  <% if payment.metadata['message'].present? %>
                    <tr class="bg-gray-50">
                      <td colspan="6" class="px-6 py-2 text-sm text-gray-600">
                        <strong>Message:</strong> <%= payment.metadata['message'] %>
                      </td>
                    </tr>
                  <% end %>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="p-8 text-center text-gray-600">
            <p>You haven't received any donations yet.</p>
            <% unless current_user.stripe_account&.charges_enabled %>
              <p class="mt-2">
                <%= link_to "Set up Stripe Connect to receive donations",
                    integrations_stripe_connect_path,
                    class: "text-blue-600 hover:text-blue-800" %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  function showTab(tab) {
    // Hide all content
    document.querySelectorAll('.tab-content').forEach(content => {
      content.classList.add('hidden');
    });

    // Remove active styles from all tabs
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.classList.remove('border-blue-500', 'text-blue-600');
      btn.classList.add('text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300');
    });

    // Show selected content
    document.getElementById(tab + '-content').classList.remove('hidden');

    // Add active styles to selected tab
    const activeTab = document.getElementById(tab + '-tab');
    activeTab.classList.remove('text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300');
    activeTab.classList.add('border-blue-500', 'text-blue-600');
  }

  // Initialize with sent tab active
  document.addEventListener('DOMContentLoaded', () => {
    showTab('sent');
  });
</script>
