<style>
  #hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: linear-gradient(135deg, var(--bg-primary) 0%, #1a1f3a 100%);
    padding: 4rem 2rem;
  }

  #hero h1 {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  #hero p {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    max-width: 600px;
  }

  #features {
    padding: 5rem 2rem;
    background: linear-gradient(135deg, #1a1f3a 0%, var(--bg-primary) 100%);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    #hero h1 {
      font-size: 2.5rem;
    }
  }

  #testimonials {
    padding: 5rem 2rem;
    background: linear-gradient(135deg, var(--bg-primary) 0%, #1a1f3a 100%);
  }

  .carousel-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .testimonial-card {
    padding: 3rem 2rem;
    text-align: center;
  }

  .testimonial-quote {
    font-size: 1.25rem;
    font-style: italic;
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .testimonial-author {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .testimonial-role {
    font-size: 1rem;
    color: var(--text-muted);
  }

  .carousel-controls {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>

<main>
  <!-- Hero Section -->
  <section id="hero" class="fade-in">
    <h1 class="gradient-text">
      The Next Generation<br>Streaming Platform
    </h1>
    <p>
      Stream with deep gaming integration, advanced community tools, and cross-platform automation. Built for creators who want more.
    </p>
    <div class="d-flex gap-3">
      <%= link_to "Get Started Free", signup_path, class: "btn-gradient-primary" %>
      <%= link_to "Learn More", "#features", class: "btn-outline-gradient" %>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features">
    <div class="text-center mb-5">
      <h2 class="display-4 mb-3">
        <span class="gradient-text">Powerful Features</span>
      </h2>
      <p class="text-muted fs-5">Everything you need to build your streaming empire</p>
    </div>

    <div class="features-grid fade-in-delay-1">
      <div class="glass-card">
        <div class="stat-card-icon">🎮</div>
        <h3 class="feature-title">Gaming Integration</h3>
        <p class="feature-description">Connect Steam, Battle.net, Riot Games, and more. Auto-update your stream with real-time game stats and ranks.</p>
      </div>

      <div class="glass-card">
        <div class="stat-card-icon">🤖</div>
        <h3 class="feature-title">Advanced Discord Bot</h3>
        <p class="feature-description">100+ commands, VC queues, loyalty points, giveaways, and mini-games. Build an engaged community.</p>
      </div>

      <div class="glass-card">
        <div class="stat-card-icon">📱</div>
        <h3 class="feature-title">Social Automation</h3>
        <p class="feature-description">Auto-post to Twitter, TikTok, Instagram, and YouTube. One-click clip sharing across all platforms.</p>
      </div>

      <div class="glass-card">
        <div class="stat-card-icon">💎</div>
        <h3 class="feature-title">Monetization Tools</h3>
        <p class="feature-description">Multiple revenue streams with subscriptions, donations, Patreon integration, and affiliate programs.</p>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonials" class="fade-in-delay-2">
    <div class="text-center mb-5">
      <h2 class="display-4 mb-3">
        <span class="gradient-text">Loved by Streamers</span>
      </h2>
      <p class="text-muted fs-5">See what creators are saying about StreamHub</p>
    </div>

    <div class="carousel-container" data-controller="carousel">
      <div class="carousel-track">
        <div class="glass-card testimonial-card active" data-carousel-target="card">
          <p class="testimonial-quote">"StreamHub's game integration is incredible. My viewers love seeing my rank update in real-time. Plus the Discord bot has taken my community to the next level!"</p>
          <p class="testimonial-author gradient-text">Alex "ProGamer" Chen</p>
          <p class="testimonial-role">Valorant Streamer • 50K Followers</p>
        </div>

        <div class="glass-card testimonial-card" data-carousel-target="card">
          <p class="testimonial-quote">"The social media automation saves me hours every week. Clips go straight to TikTok and Twitter with one click. Game changer for content creators."</p>
          <p class="testimonial-author gradient-text">Sarah "StreamQueen" Martinez</p>
          <p class="testimonial-role">Variety Streamer • 100K Followers</p>
        </div>

        <div class="glass-card testimonial-card" data-carousel-target="card">
          <p class="testimonial-quote">"I switched from Twitch and never looked back. The monetization tools and 48 platform integrations make StreamHub the complete package for serious streamers."</p>
          <p class="testimonial-author gradient-text">Mike "TheGrinder" Johnson</p>
          <p class="testimonial-role">WoW Streamer • Partner</p>
        </div>

        <div class="glass-card testimonial-card" data-carousel-target="card">
          <p class="testimonial-quote">"As a League streamer, showing my match history and champion mastery automatically on my profile is awesome. My engagement has doubled since joining StreamHub."</p>
          <p class="testimonial-author gradient-text">Emma "MidLaneGG" Wilson</p>
          <p class="testimonial-role">League of Legends Streamer • 75K Followers</p>
        </div>
      </div>

      <div class="carousel-controls">
        <button class="btn-gradient-secondary carousel-btn-prev" data-action="click->carousel#prev">
          <i class="bi bi-arrow-left"></i> Previous
        </button>
        <button class="btn-gradient-secondary carousel-btn-next" data-action="click->carousel#next">
          Next <i class="bi bi-arrow-right"></i>
        </button>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="text-center py-5 my-5">
    <div class="container">
      <h2 class="display-3 mb-4">
        <span class="gradient-text">Ready to Level Up?</span>
      </h2>
      <p class="fs-5 text-muted mb-4">
        Join thousands of streamers building their community on StreamHub
      </p>
      <%= link_to "Start Streaming Free", signup_path, class: "btn-gradient-primary btn-lg" %>
    </div>
  </section>
</main>
