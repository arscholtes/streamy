<%# app/views/dashboard/index.html.erb %>
<%# StreamHub Dashboard - Modern Dark Design %>

<% content_for :title, "Dashboard" %>

<%# Hero Header Section %>
<div style="background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-secondary) 100%); padding: 3rem 0; margin-bottom: 2rem; position: relative; overflow: hidden;">
  <div style="position: absolute; top: -50%; right: -10%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(139, 92, 246, 0.15), transparent); border-radius: 50%; filter: blur(80px);"></div>

  <div class="container-fluid">
    <div class="row align-items-center fade-in">
      <div class="col-md-8">
        <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; margin-bottom: 0.5rem;">
          Welcome back, <span class="gradient-text"><%= current_user.username %></span>! 👋
        </h1>
        <p style="font-size: 1.125rem; color: var(--text-muted); margin-bottom: 0;">
          Here's what's happening with your stream
        </p>
      </div>
      <div class="col-md-4 text-end">
        <% if @stream.status == 'live' %>
          <div class="badge-live" style="font-size: 1.25rem; padding: 0.75rem 1.5rem; animation: pulse-glow 2s infinite;">
            <i class="bi bi-broadcast"></i> YOU'RE LIVE
          </div>
        <% else %>
          <%= link_to "Start Streaming", "#setup", class: "btn-gradient-primary", style: "font-size: 1rem; padding: 0.75rem 2rem;" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="container-fluid">
  <%# Statistics Cards %>
  <div class="row mb-4 fade-in-delay-1">
    <%# Total Streams Card %>
    <div class="col-xl-3 col-md-6 mb-3">
      <div class="stat-card" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%); border: 1px solid rgba(59, 130, 246, 0.2);">
        <div class="stat-card-icon">📊</div>
        <div class="stat-card-value"><%= @total_streams %></div>
        <div class="stat-card-label">Total Streams</div>
        <div style="margin-top: 0.5rem; font-size: 0.875rem; color: var(--accent-green);">
          <i class="bi bi-arrow-up"></i> All time
        </div>
      </div>
    </div>

    <%# Active Streams Card %>
    <div class="col-xl-3 col-md-6 mb-3">
      <div class="stat-card" style="background: linear-gradient(135deg, <%= @active_streams > 0 ? 'rgba(239, 68, 68, 0.1)' : 'rgba(255, 255, 255, 0.03)' %> 0%, rgba(139, 92, 246, 0.05) 100%); border: 1px solid <%= @active_streams > 0 ? 'rgba(239, 68, 68, 0.3)' : 'rgba(255, 255, 255, 0.1)' %>;">
        <div class="stat-card-icon"><%= @active_streams > 0 ? '🔴' : '⚫' %></div>
        <div class="stat-card-value"><%= @active_streams %></div>
        <div class="stat-card-label">
          <% if @active_streams > 0 %>
            <span class="badge-live">
              <i class="bi bi-circle-fill"></i> LIVE NOW
            </span>
          <% else %>
            <span class="badge-offline">Offline</span>
          <% end %>
        </div>
      </div>
    </div>

    <%# Subscription Tier Card %>
    <div class="col-xl-3 col-md-6 mb-3">
      <div class="stat-card" style="background: linear-gradient(135deg, <%= @subscription == 'free' ? 'rgba(245, 158, 11, 0.1)' : 'rgba(139, 92, 246, 0.15)' %> 0%, rgba(59, 130, 246, 0.1) 100%); border: 1px solid <%= @subscription == 'free' ? 'rgba(245, 158, 11, 0.3)' : 'rgba(139, 92, 246, 0.4)' %>;">
        <div class="stat-card-icon">
          <%= @subscription == "free" ? '⭐' : '💎' %>
        </div>
        <div class="stat-card-value text-capitalize"><%= @subscription %></div>
        <div class="stat-card-label">
          <% if @subscription == "pro" || @subscription == "enterprise" %>
            <span class="badge-pro">PREMIUM</span>
          <% else %>
            Subscription
          <% end %>
        </div>
        <% if @subscription == "free" %>
          <%= link_to settings_path(anchor: "billing"), class: "btn-gradient-primary btn-sm mt-3", style: "font-size: 0.875rem; padding: 0.5rem 1rem; width: 100%;" do %>
            <i class="bi bi-arrow-up-circle"></i> Upgrade Now
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Integrations Card %>
    <div class="col-xl-3 col-md-6 mb-3">
      <div class="stat-card" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%); border: 1px solid rgba(16, 185, 129, 0.3);">
        <div class="stat-card-icon">🎮</div>
        <div class="stat-card-value">
          <% connected_count = [
            @steam_connected ? 1 : 0,
            @discord_connected ? 1 : 0
          ].sum rescue 0 %>
          <%= connected_count %>
        </div>
        <div class="stat-card-label">Integrations</div>
        <%= link_to settings_path, class: "btn-outline-gradient btn-sm mt-3", style: "font-size: 0.875rem; padding: 0.5rem 1rem; width: 100%;" do %>
          <i class="bi bi-plus-circle"></i> Connect More
        <% end %>
      </div>
    </div>
  </div>

  <%# Business Dashboard Link %>
  <div class="row mb-4 fade-in-delay-1">
    <div class="col-12">
      <%= link_to business_path, style: "text-decoration: none;" do %>
        <div class="glass-card" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(5, 150, 105, 0.1) 100%); border: 2px solid rgba(16, 185, 129, 0.3); transition: all 0.3s ease; cursor: pointer;" onmouseover="this.style.borderColor='rgba(16, 185, 129, 0.6)'; this.style.transform='translateY(-2px)';" onmouseout="this.style.borderColor='rgba(16, 185, 129, 0.3)'; this.style.transform='translateY(0)';">
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem;">
            <div style="display: flex; align-items: center; gap: 1.5rem;">
              <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #10B981, #059669); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 2rem;">
                💼
              </div>
              <div>
                <h4 style="margin-bottom: 0.25rem; font-size: 1.5rem; font-weight: 700;">
                  <span class="gradient-text">Business Dashboard</span>
                </h4>
                <p style="color: var(--text-muted); margin: 0; font-size: 0.95rem;">
                  Track revenue, manage expenses, and grow your streaming business
                </p>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
              <i class="bi bi-arrow-right-circle" style="font-size: 2rem; color: var(--accent-green);"></i>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Main Content Row %>
  <div class="row fade-in-delay-2">
    <%# Stream Setup Column %>
    <div class="col-lg-8 mb-4">
      <div class="glass-card" id="setup" style="position: relative;">
        <%# Live indicator badge %>
        <% if @stream.status == 'live' %>
          <div style="position: absolute; top: 1.5rem; right: 1.5rem;">
            <span class="badge-live" style="font-size: 0.875rem;">
              <i class="bi bi-broadcast"></i> STREAMING
            </span>
          </div>
        <% end %>

        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
          <div style="width: 60px; height: 60px; background: var(--gradient-primary); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-size: 2rem;">
            <%= @stream.status == 'live' ? '🎥' : '📹' %>
          </div>
          <div>
            <h3 style="margin-bottom: 0.25rem; font-size: 1.75rem; font-weight: 700;">
              <span class="gradient-text">Stream Setup</span>
            </h3>
            <p style="color: var(--text-muted); margin: 0;">Configure OBS and go live</p>
          </div>
        </div>

        <%# Stream Status %>
        <div style="background: <%= @stream.status == 'live' ? 'rgba(239, 68, 68, 0.1)' : 'rgba(255, 255, 255, 0.03)' %>; border: 1px solid <%= @stream.status == 'live' ? 'rgba(239, 68, 68, 0.3)' : 'rgba(255, 255, 255, 0.1)' %>; border-radius: var(--radius-lg); padding: 2rem; margin-bottom: 2rem;">
          <div class="row align-items-center">
            <div class="col-md-8">
              <h4 style="font-size: 1.5rem; margin-bottom: 0.5rem;"><%= @stream.title %></h4>
              <p style="color: var(--text-muted); margin: 0;">
                Status:
                <span style="font-weight: 600; color: <%= @stream.status == 'live' ? 'var(--accent-red)' : 'var(--text-secondary)' %>; text-transform: uppercase;">
                  <%= @stream.status %>
                </span>
              </p>
            </div>
            <div class="col-md-4 text-center">
              <% if @stream.status == 'live' %>
                <i class="bi bi-broadcast" style="font-size: 4rem; color: var(--accent-red);"></i>
              <% else %>
                <i class="bi bi-camera-video-off" style="font-size: 4rem; color: var(--text-muted);"></i>
              <% end %>
            </div>
          </div>
        </div>

        <%# RTMP Configuration %>
        <div style="margin-bottom: 2rem;">
          <h5 style="color: var(--text-secondary); margin-bottom: 1rem; font-weight: 600;">
            <i class="bi bi-server"></i> RTMP Server URL
          </h5>
          <div class="input-group">
            <input type="text" class="form-control-dark" value="rtmp://localhost:1935/live" readonly style="font-family: 'Courier New', monospace; font-size: 0.95rem;">
            <button class="btn-gradient-secondary" type="button" onclick="copyToClipboard('rtmp://localhost:1935/live', this)">
              <i class="bi bi-clipboard"></i> Copy
            </button>
          </div>
        </div>

        <div style="margin-bottom: 2rem;">
          <h5 style="color: var(--text-secondary); margin-bottom: 1rem; font-weight: 600;">
            <i class="bi bi-key"></i> Stream Key
          </h5>
          <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1rem;">
            <i class="bi bi-shield-exclamation" style="color: var(--accent-yellow);"></i>
            <strong style="color: var(--accent-yellow);">Keep this secret!</strong>
            <span style="color: var(--text-muted);">Never share your stream key publicly.</span>
          </div>
          <div class="input-group">
            <input type="password" class="form-control-dark" value="<%= current_user.stream_key %>" id="streamKeyInput" readonly style="font-family: 'Courier New', monospace; font-size: 0.95rem;">
            <button class="btn-outline-gradient" type="button" onclick="toggleStreamKey()">
              <i class="bi bi-eye" id="eyeIcon"></i>
            </button>
            <button class="btn-gradient-secondary" type="button" onclick="copyToClipboard('<%= current_user.stream_key %>', this)">
              <i class="bi bi-clipboard"></i> Copy
            </button>
          </div>
        </div>

        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <%= link_to edit_stream_path(@stream), class: "btn-gradient-primary" do %>
            <i class="bi bi-pencil"></i> Edit Stream
          <% end %>
          <button class="btn-outline-gradient" data-bs-toggle="modal" data-bs-target="#obsGuideModal">
            <i class="bi bi-info-circle"></i> OBS Setup Guide
          </button>
          <%= link_to "https://obsproject.com/download", target: "_blank", class: "btn-outline-gradient" do %>
            <i class="bi bi-download"></i> Get OBS
          <% end %>
        </div>
      </div>
    </div>

    <%# Sidebar Column %>
    <div class="col-lg-4 mb-4">
      <%# Quick Stats %>
      <div class="glass-card mb-3">
        <h5 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;">
          <i class="bi bi-graph-up gradient-text"></i>
          <span class="gradient-text">Quick Stats</span>
        </h5>

        <div style="margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="color: var(--text-muted); font-size: 0.875rem;">Account Age</span>
            <span style="color: var(--text-primary); font-weight: 600;"><%= time_ago_in_words(current_user.created_at) %></span>
          </div>
          <div style="background: rgba(255, 255, 255, 0.1); height: 4px; border-radius: 2px; overflow: hidden;">
            <div style="background: var(--gradient-primary); height: 100%; width: 100%;"></div>
          </div>
        </div>

        <div style="margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="color: var(--text-muted); font-size: 0.875rem;">Total Streams</span>
            <span style="color: var(--text-primary); font-weight: 600;"><%= @total_streams %></span>
          </div>
          <div style="background: rgba(255, 255, 255, 0.1); height: 4px; border-radius: 2px; overflow: hidden;">
            <div style="background: var(--gradient-primary); height: 100%; width: <%= [@total_streams * 10, 100].min %>%;"></div>
          </div>
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="color: var(--text-muted); font-size: 0.875rem;">Subscription</span>
            <span class="<%= @subscription == 'free' ? 'text-capitalize' : 'badge-pro' %>" style="font-weight: 600;">
              <%= @subscription == 'free' ? @subscription : 'PREMIUM' %>
            </span>
          </div>
          <div style="background: rgba(255, 255, 255, 0.1); height: 4px; border-radius: 2px; overflow: hidden;">
            <div style="background: <%= @subscription == 'free' ? 'linear-gradient(135deg, #F59E0B, #EF4444)' : 'var(--gradient-primary)' %>; height: 100%; width: <%= @subscription == 'free' ? '33%' : '100%' %>;"></div>
          </div>
        </div>
      </div>

      <%# Integrations Preview %>
      <div class="glass-card mb-3">
        <h5 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;">
          <i class="bi bi-puzzle gradient-text"></i>
          <span class="gradient-text">Connected Services</span>
        </h5>

        <% if defined?(@steam_connected) && @steam_connected %>
          <div style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #1b2838, #2a475e); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                🎮
              </div>
              <div style="flex: 1;">
                <div style="font-weight: 600; margin-bottom: 0.25rem;">Steam</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Connected</div>
              </div>
              <i class="bi bi-check-circle-fill" style="color: var(--accent-green); font-size: 1.25rem;"></i>
            </div>
          </div>
        <% end %>

        <% if defined?(@discord_connected) && @discord_connected %>
          <div style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #5865F2, #7289DA); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                💬
              </div>
              <div style="flex: 1;">
                <div style="font-weight: 600; margin-bottom: 0.25rem;">Discord</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">Connected</div>
              </div>
              <i class="bi bi-check-circle-fill" style="color: var(--accent-green); font-size: 1.25rem;"></i>
            </div>
          </div>
        <% end %>

        <% connected_count = [
          (defined?(@steam_connected) && @steam_connected ? 1 : 0),
          (defined?(@discord_connected) && @discord_connected ? 1 : 0)
        ].sum %>

        <% if connected_count == 0 %>
          <div style="background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: var(--radius-md); padding: 1.5rem; text-align: center;">
            <i class="bi bi-link-45deg" style="font-size: 2.5rem; color: var(--accent-purple); margin-bottom: 0.5rem; display: block;"></i>
            <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.875rem;">
              Connect your gaming and social accounts to unlock powerful features
            </p>
            <%= link_to settings_path, class: "btn-gradient-primary btn-sm", style: "width: 100%;" do %>
              <i class="bi bi-plus-circle"></i> Connect Services
            <% end %>
          </div>
        <% else %>
          <div style="text-align: center; padding: 1rem 0;">
            <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 0.75rem;">
              <%= connected_count %> of 48 integrations connected
            </p>
            <%= link_to settings_path, class: "btn-outline-gradient btn-sm", style: "width: 100%;" do %>
              <i class="bi bi-plus-circle"></i> Add More
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Subscription Upgrade %>
      <% if @subscription == "free" %>
        <div class="glass-card" style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%); border: 1px solid rgba(139, 92, 246, 0.3);">
          <div style="text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 1rem;">💎</div>
            <h5 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">
              <span class="gradient-text">Upgrade to Pro</span>
            </h5>
            <p style="color: var(--text-muted); font-size: 0.875rem; margin-bottom: 1.5rem;">
              Unlock premium features and take your stream to the next level
            </p>
            <ul style="list-style: none; padding: 0; text-align: left; margin-bottom: 1.5rem;">
              <li style="padding: 0.5rem 0; color: var(--text-secondary); font-size: 0.875rem;">
                <i class="bi bi-check-circle-fill" style="color: var(--accent-green);"></i> 1080p streaming
              </li>
              <li style="padding: 0.5rem 0; color: var(--text-secondary); font-size: 0.875rem;">
                <i class="bi bi-check-circle-fill" style="color: var(--accent-green);"></i> All 48 integrations
              </li>
              <li style="padding: 0.5rem 0; color: var(--text-secondary); font-size: 0.875rem;">
                <i class="bi bi-check-circle-fill" style="color: var(--accent-green);"></i> Custom branding
              </li>
              <li style="padding: 0.5rem 0; color: var(--text-secondary); font-size: 0.875rem;">
                <i class="bi bi-check-circle-fill" style="color: var(--accent-green);"></i> Priority support
              </li>
            </ul>
            <%= link_to settings_path(anchor: "billing"), class: "btn-gradient-primary", style: "width: 100%;" do %>
              <i class="bi bi-arrow-up-circle"></i> Upgrade Now - $19/mo
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="glass-card" style="border: 1px solid rgba(139, 92, 246, 0.5);">
          <div style="text-align: center;">
            <div style="font-size: 3rem; margin-bottom: 1rem;">✨</div>
            <h5 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem;">
              <span class="gradient-text">Premium Active</span>
            </h5>
            <p style="color: var(--accent-green); font-size: 0.875rem;">
              <i class="bi bi-check-circle-fill"></i>
              You have access to all premium features!
            </p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# OBS Guide Modal %>
<div class="modal fade" id="obsGuideModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content" style="background: var(--bg-secondary); border: 1px solid rgba(255, 255, 255, 0.1);">
      <div class="modal-header" style="border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
        <h5 class="modal-title">
          <i class="bi bi-info-circle gradient-text"></i>
          <span class="gradient-text">OBS Studio Setup Guide</span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div style="background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: var(--radius-md); padding: 1.5rem; margin-bottom: 2rem;">
          <h6 style="color: var(--accent-blue); margin-bottom: 0.5rem;">
            <i class="bi bi-lightbulb"></i> Quick Setup
          </h6>
          <p style="color: var(--text-secondary); margin: 0; font-size: 0.875rem;">
            Follow these 3 simple steps to start streaming on StreamHub
          </p>
        </div>

        <div style="margin-bottom: 2rem;">
          <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
            <div style="width: 40px; height: 40px; background: var(--gradient-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">1</div>
            <div>
              <h6 style="font-weight: 700; margin-bottom: 0.5rem;">Download OBS Studio</h6>
              <p style="color: var(--text-secondary); margin-bottom: 0.5rem;">
                Visit <a href="https://obsproject.com/download" target="_blank" class="gradient-text" style="text-decoration: none; font-weight: 600;">obsproject.com/download</a> and install OBS for your operating system.
              </p>
            </div>
          </div>
        </div>

        <div style="margin-bottom: 2rem;">
          <div style="display: flex; gap: 1rem; margin-bottom: 1rem;">
            <div style="width: 40px; height: 40px; background: var(--gradient-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">2</div>
            <div style="flex: 1;">
              <h6 style="font-weight: 700; margin-bottom: 0.5rem;">Configure Stream Settings</h6>
              <ol style="color: var(--text-secondary); margin: 0; padding-left: 1.25rem;">
                <li style="margin-bottom: 0.5rem;">Open OBS Studio</li>
                <li style="margin-bottom: 0.5rem;">Go to <strong style="color: var(--text-primary);">Settings → Stream</strong></li>
                <li style="margin-bottom: 0.5rem;">Service: Select <strong style="color: var(--text-primary);">Custom</strong></li>
                <li style="margin-bottom: 0.5rem;">Server: <code style="background: rgba(139, 92, 246, 0.2); padding: 0.25rem 0.5rem; border-radius: 4px; color: var(--accent-purple); font-size: 0.875rem;">rtmp://localhost:1935/live</code></li>
                <li>Stream Key: <code style="background: rgba(139, 92, 246, 0.2); padding: 0.25rem 0.5rem; border-radius: 4px; color: var(--accent-purple); font-size: 0.75rem;"><%= current_user.stream_key %></code></li>
              </ol>
            </div>
          </div>
        </div>

        <div>
          <div style="display: flex; gap: 1rem;">
            <div style="width: 40px; height: 40px; background: var(--gradient-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">3</div>
            <div>
              <h6 style="font-weight: 700; margin-bottom: 0.5rem;">Start Streaming</h6>
              <p style="color: var(--text-secondary); margin: 0;">
                Click the <strong style="color: var(--text-primary);">Start Streaming</strong> button in OBS and you'll be live on StreamHub! 🎉
              </p>
            </div>
          </div>
        </div>

        <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-md); padding: 1rem; margin-top: 2rem;">
          <p style="color: var(--text-secondary); margin: 0; font-size: 0.875rem;">
            <i class="bi bi-info-circle" style="color: var(--accent-green);"></i>
            Need help? Check out our <a href="#" class="gradient-text" style="text-decoration: none; font-weight: 600;">full documentation</a> or contact support.
          </p>
        </div>
      </div>
      <div class="modal-footer" style="border-top: 1px solid rgba(255, 255, 255, 0.1);">
        <button type="button" class="btn-outline-gradient" data-bs-dismiss="modal">Close</button>
        <%= link_to "https://obsproject.com/download", target: "_blank", class: "btn-gradient-primary" do %>
          <i class="bi bi-download"></i> Download OBS
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
// Toggle stream key visibility
function toggleStreamKey() {
  const input = document.getElementById('streamKeyInput');
  const icon = document.getElementById('eyeIcon');

  if (input.type === 'password') {
    input.type = 'text';
    icon.classList.remove('bi-eye');
    icon.classList.add('bi-eye-slash');
  } else {
    input.type = 'password';
    icon.classList.remove('bi-eye-slash');
    icon.classList.add('bi-eye');
  }
}

// Copy to clipboard with feedback
function copyToClipboard(text, button) {
  navigator.clipboard.writeText(text).then(() => {
    const originalHTML = button.innerHTML;
    button.innerHTML = '<i class="bi bi-check"></i> Copied!';
    button.style.background = 'linear-gradient(135deg, #10B981, #059669)';

    setTimeout(() => {
      button.innerHTML = originalHTML;
      button.style.background = '';
    }, 2000);
  });
}
</script>
