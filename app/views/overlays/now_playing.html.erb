<%# Now Playing Overlay - Shows current game or music %>

<% content_for :styles do %>
<style>
  .now-playing-overlay {
    position: absolute;
    bottom: 20px;
    right: 20px;
    max-width: 400px;
  }

  .now-playing-card {
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    padding: 20px;
    display: none;
  }

  .now-playing-card.visible {
    display: block;
    animation: slideInRight 0.5s ease-out;
  }

  @keyframes slideInRight {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  .now-playing-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .music-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #1DB954 0%, #1ed760 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .game-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .now-playing-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .now-playing-content {
    margin-top: 12px;
  }

  .track-name {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
    color: #ffffff;
  }

  .track-artist {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 4px;
  }

  .game-name {
    font-size: 22px;
    font-weight: 700;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .playing-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    padding: 6px 12px;
    background: rgba(16, 185, 129, 0.2);
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 16px;
    font-size: 12px;
    font-weight: 600;
    color: #10b981;
  }

  .playing-dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .music-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 20px;
  }

  .music-bar {
    width: 3px;
    background: #1DB954;
    border-radius: 2px;
    animation: musicBar 0.8s ease-in-out infinite;
  }

  .music-bar:nth-child(1) {
    animation-delay: 0s;
  }

  .music-bar:nth-child(2) {
    animation-delay: 0.2s;
  }

  .music-bar:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes musicBar {
    0%, 100% {
      height: 8px;
    }
    50% {
      height: 20px;
    }
  }

  .nothing-playing {
    text-align: center;
    padding: 20px;
    color: rgba(255, 255, 255, 0.5);
    font-style: italic;
  }
</style>
<% end %>

<div class="now-playing-overlay">
  <div id="now-playing-card" class="now-playing-card">
    <!-- Content will be dynamically updated -->
  </div>
</div>

<% content_for :scripts do %>
<script>
  let updateInterval;
  let currentService = null;

  async function updateNowPlaying() {
    const data = await fetchOverlayData();
    if (!data) return;

    const card = document.getElementById('now-playing-card');

    if (data.playing && data.service === 'spotify') {
      // Spotify music
      card.className = 'now-playing-card visible';
      card.innerHTML = `
        <div class="now-playing-header">
          <div class="music-icon">🎵</div>
          <div>
            <div class="now-playing-label">Now Playing on Spotify</div>
            <div class="music-bars">
              <div class="music-bar"></div>
              <div class="music-bar"></div>
              <div class="music-bar"></div>
            </div>
          </div>
        </div>
        <div class="now-playing-content">
          <div class="track-name">${data.track?.name || 'Unknown Track'}</div>
          <div class="track-artist">${data.track?.artist || 'Unknown Artist'}</div>
          <div class="playing-indicator">
            <div class="playing-dot"></div>
            Playing
          </div>
        </div>
      `;
      currentService = 'spotify';

    } else if (data.playing && data.service === 'steam' && data.game) {
      // Steam game
      card.className = 'now-playing-card visible';
      card.innerHTML = `
        <div class="now-playing-header">
          <div class="game-icon">🎮</div>
          <div>
            <div class="now-playing-label">Currently Playing</div>
          </div>
        </div>
        <div class="now-playing-content">
          <div class="game-name">${data.game.name}</div>
          <div class="playing-indicator">
            <div class="playing-dot"></div>
            In Game
          </div>
        </div>
      `;
      currentService = 'steam';

    } else {
      // Nothing playing - hide card
      if (currentService) {
        // Add slide out animation
        card.style.animation = 'slideOutRight 0.3s ease-out';
        setTimeout(() => {
          card.className = 'now-playing-card';
          card.style.animation = '';
          currentService = null;
        }, 300);
      }
    }
  }

  // Initial load
  updateNowPlaying();

  // Update every 5 seconds
  updateInterval = setInterval(updateNowPlaying, 5000);

  // Cleanup
  window.addEventListener('beforeunload', () => {
    if (updateInterval) clearInterval(updateInterval);
  });
</script>

<style>
  @keyframes slideOutRight {
    from {
      transform: translateX(0);
      opacity: 1;
    }
    to {
      transform: translateX(100%);
      opacity: 0;
    }
  }
</style>
<% end %>
