<%# app/views/registrations/new.html.erb %>
<%# This is the signup form view %>
<%# Learn more about ERB templates: https://guides.rubyonrails.org/layouts_and_rendering.html %>

<%# Set the page title %>
<% content_for :title, "Sign Up" %>

<div class="container">
  <div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5 fade-in">
      <%# Glass card for the signup form %>
      <div class="glass-card" style="box-shadow: var(--glow-purple);">
        <div class="text-center mb-4">
          <h2 class="gradient-text"><i class="bi bi-person-plus"></i> Create Your Account</h2>
          <p style="color: var(--text-muted); margin-top: 0.5rem;">Join StreamHub and start streaming</p>
        </div>
        <%# form_with is a Rails form helper %>
        <%# model: @user - binds form to the User object %>
        <%# url: registration_path - submits to POST /registration %>
        <%# local: true - disables Turbo/AJAX (submits normally) %>
        <%= form_with model: @user, url: registration_path, local: true do |form| %>

          <%# Display validation errors if present %>
          <% if @user.errors.any? %>
            <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid var(--accent-red); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.5rem;">
              <h5 style="color: var(--accent-red); margin-bottom: 0.75rem;">
                <%= pluralize(@user.errors.count, "error") %> prohibited this account from being saved:
              </h5>
              <ul class="mb-0" style="color: var(--text-secondary);">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%# Username field %>
          <div class="mb-4">
            <%= form.label :username, "Username", class: "form-label", style: "color: var(--text-secondary);" %>
            <%= form.text_field :username,
              class: "form-control-dark #{'is-invalid' if @user.errors[:username].any?}",
              placeholder: "Choose a unique username",
              required: true,
              autofocus: true,
              autocomplete: "username" %>
            <% if @user.errors[:username].any? %>
              <div class="invalid-feedback d-block">
                <%= @user.errors[:username].join(", ") %>
              </div>
            <% end %>
            <div class="form-text" style="color: var(--text-muted);">
              3-50 characters. Letters, numbers, and underscores only.
            </div>
          </div>

          <%# Email field %>
          <div class="mb-4">
            <%= form.label :email, "Email Address", class: "form-label", style: "color: var(--text-secondary);" %>
            <%= form.email_field :email,
              class: "form-control-dark #{'is-invalid' if @user.errors[:email].any?}",
              placeholder: "Enter your email address",
              required: true,
              autocomplete: "email" %>
            <% if @user.errors[:email].any? %>
              <div class="invalid-feedback d-block">
                <%= @user.errors[:email].join(", ") %>
              </div>
            <% end %>
          </div>

          <%# Password field %>
          <div class="mb-4">
            <%= form.label :password, "Password", class: "form-label", style: "color: var(--text-secondary);" %>
            <%= form.password_field :password,
              class: "form-control-dark #{'is-invalid' if @user.errors[:password].any?}",
              placeholder: "Choose a strong password",
              required: true,
              autocomplete: "new-password" %>
            <% if @user.errors[:password].any? %>
              <div class="invalid-feedback d-block">
                <%= @user.errors[:password].join(", ") %>
              </div>
            <% end %>
            <div class="form-text" style="color: var(--text-muted);">
              Minimum 6 characters.
            </div>
          </div>

          <%# Password confirmation field %>
          <div class="mb-4">
            <%= form.label :password_confirmation, "Confirm Password", class: "form-label", style: "color: var(--text-secondary);" %>
            <%= form.password_field :password_confirmation,
              class: "form-control-dark #{'is-invalid' if @user.errors[:password_confirmation].any?}",
              placeholder: "Re-enter your password",
              required: true,
              autocomplete: "new-password" %>
            <% if @user.errors[:password_confirmation].any? %>
              <div class="invalid-feedback d-block">
                <%= @user.errors[:password_confirmation].join(", ") %>
              </div>
            <% end %>
          </div>

          <%# Submit button %>
          <div class="d-grid mb-4">
            <%= form.submit "Create Account", class: "btn-gradient-primary" %>
          </div>
        <% end %>

        <%# Link to login page %>
        <div class="text-center">
          <p style="color: var(--text-muted);">
            Already have an account?
            <%= link_to "Log in here", login_path, class: "gradient-text", style: "text-decoration: none; font-weight: 600;" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
